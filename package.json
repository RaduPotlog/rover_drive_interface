    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foxglove/ros2idl-parser": "^0.3.6",
    "@foxglove/rosmsg": "^5.0.4",
    "@foxglove/rosmsg2-serialization": "^3.0.2",
    "@foxglove/ws-protocol": "^0.8.0",
    "eventemitter3": "^5.0.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
