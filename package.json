{
  "name": "rover-drive-interface",
  "private": true,
  "version": "0.1.0",
  "description": "Browser drive interface for rover_a1 (Clearpath Boxer / IndoorNav style), talking ROS 2 through foxglove_bridge",
  "type": "module",
  "license": "Apache-2.0 AND LGPL-2.1-or-later",
  "scripts": {
    "dev": "vite",
